# Copy to .env and replace every placeholder. Never commit .env.

# db
POSTGRES_USER=wrs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wrs

# api (host is 127.0.0.1 for local dev: the db port is published on IPv4 only; the api container uses host "db")
DATABASE_URL=postgresql://wrs:change-me@127.0.0.1:5432/wrs?schema=public
JWT_SECRET=replace-with-32-plus-random-characters
JWT_EXPIRES_IN=8h
PORT=3000
SEED_ON_START=false
SEED_SUPERVISOR_PASSWORD=change-me
SEED_OPERATOR_PASSWORD=change-me

# web
WEB_PORT=8080
